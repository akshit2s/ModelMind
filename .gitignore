# ==============================
# PYTHON ENVIRONMENT
# ==============================

venv/
.venv/
env/
__pycache__/
*.py[cod]

# ==============================
# ENVIRONMENT VARIABLES / SECRETS
# ==============================

.env
.env.*
!.env.example

# Credentials and private keys
*.pem
*.key
*.p12
*.pfx

# ==============================
# LOCAL DATASETS
# ==============================

# Never track datasets by default
datasets/*

# Keep the datasets directory in Git
!datasets/.gitkeep

# Ignore common data files everywhere
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.jsonl
*.sqlite
*.db

# ==============================
# GENERATED REPORTS
# ==============================

reports/*
!reports/.gitkeep

# ==============================
# EDITOR / SYSTEM FILES
# ==============================

.vscode/
.DS_Store
Thumbs.db